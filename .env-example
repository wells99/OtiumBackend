PORT=3000
NODE_ENV=development

# Preencha o host MySQL mostrado no hPanel e a senha do banco.
# Codifique caracteres especiais da senha para URL (por exemplo, @ vira %40).
DATABASE_URL="mysql://uasdfafdfdfsdf_otium:SUA_SENHA_URL_ENCODED@HOST_MYSQL_DA_HOSTINGER:3306/asdfasd_otiumflix"
JWT_SECRET="chave_secreta_jwt_para_desenvolvimento_troque_em_producao"
TRIAL_DAYS=2

JELLYFIN_URL=http://seujelyfin:8096
JELLYFIN_API_KEY=COLOQUE_SUA_CHAVE_AQUI

# Ferramenta temporária para sincronizar usuários; deixe desligada fora do uso.
USER_SYNC_ENABLED=false
USER_SYNC_KEY=gere_uma_chave_aleatoria_longa_para_uso_local

# InfinitePay Checkout Integrado (mantenha a API Key apenas no .env do backend)
INFINITEPAY_API_KEY=COLOQUE_SUA_API_KEY_AQUI
INFINITEPAY_HANDLE=sua-infinite-tag-sem-cifrao
PUBLIC_APP_URL=https://seusite.com

# Deixe o worker desligado até validar o volume MeTube compartilhado com Jellyfin.
YOUTUBE_CHANNELS_WORKER_ENABLED=false
YOUTUBE_CHANNELS_CHECK_CRON=0 8,14,20 * * *
YOUTUBE_METUBE_URL=http://seuMetube:8081
